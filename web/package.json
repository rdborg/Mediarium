{
  "name": "mediarium-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "guide": "node --experimental-strip-types --no-warnings tools/build-guide.mjs",
    "predev": "npm run guide",
    "dev": "vite",
    "prebuild": "npm run guide",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "i18n": "node tools/i18n-check.mjs",
    "e2e": "playwright test",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --no-warnings --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "epubjs": "0.3.93",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.86.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.15"
  }
}
