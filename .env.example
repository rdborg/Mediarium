# Copy to .env and adjust. These are container-level settings only —
# everything else (indexers, download clients, naming, VPN) is configured
# from the app's Settings UI after first run.

# File ownership — match your NAS user (id -u / id -g on Synology/Unraid)
PUID=1000
PGID=1000

# Timezone, e.g. Europe/Malta
TZ=Etc/UTC

# Optional, only when BUILDING the image yourself: app-wide keys baked into
# the binary so end users do not have to make their own accounts. Leave empty
# and the app asks for keys in the setup wizard instead. Register these
# yourself (themoviedb.org, opensubtitles.com/consumers, trakt.tv/oauth/applications).
# TMDB_API_KEY=
# OPENSUBTITLES_API_KEY=
# TRAKT_CLIENT_ID=

# Port the web UI is served on inside the container
APP_PORT=8080
