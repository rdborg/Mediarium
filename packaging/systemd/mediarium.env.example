# Environment for the native systemd service (see mediarium.service).
# Copy to /etc/mediarium/mediarium.env and edit. STATUS: UNTESTED.
#
# PUID/PGID/TZ are NOT used here: they belong to the Docker entrypoint. A
# native process runs as the systemd User= and uses the system timezone.

# Where app.db and secret.key live. Back this folder up (both files together).
CONFIG_DIR=/var/lib/mediarium/config

# Keep these three on the SAME filesystem (ideally one parent folder) so imports
# hardlink instead of copying. Example layout: /srv/media/{downloads,movies,tv}
DOWNLOADS_DIR=/srv/media/downloads
MOVIES_DIR=/srv/media/movies
TV_DIR=/srv/media/tv

# Web UI port.
APP_PORT=8080
