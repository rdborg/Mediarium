# For building Mediarium from source with docker-compose.dev.yml.
# Copy to .env and adjust. (The normal install, docker-compose.yml, does not
# need this file: edit the values in docker-compose.yml itself.)
# These are container-level settings only; everything else (indexers, download
# clients, naming, VPN) is set up in the app's Settings after first run.

# Use docker-compose.dev.yml for plain "docker compose" commands in this folder.
# COMPOSE_FILE=docker-compose.dev.yml

# File ownership: match the owner of your folders (run "id" to see the numbers)
PUID=1000
PGID=1000

# Timezone, e.g. Europe/London
TZ=Etc/UTC

# Optional, only when BUILDING the image yourself: app-wide keys baked into
# the binary so users don't have to make their own accounts. Leave them empty
# and the app asks for keys in the setup wizard instead. Register these
# yourself (themoviedb.org, opensubtitles.com/consumers, trakt.tv/oauth/applications).
# TMDB_API_KEY=
# OPENSUBTITLES_API_KEY=
# TRAKT_CLIENT_ID=

# The port on your machine that maps to the app (the app itself listens on 8264 inside).
# HOST_PORT=8264

# The torrent port, 58264 TCP and UDP, is published as it is in
# docker-compose.dev.yml (optional, lets other peers connect to you). To use
# another port, change both numbers there and the Listen port in Settings >
# Downloading > Usenet and torrents.
