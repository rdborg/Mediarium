{
  "cosmos-installer": {
    "form": [
      {
        "name": "data_path",
        "label": "Folder on the server that holds your downloads, movies and TV (use one folder, so imports are hardlinked)",
        "initialValue": "{DefaultDataPath}/media",
        "type": "text"
      }
    ]
  },
  "minVersion": "0.8.0",
  "services": {
    "{ServiceName}": {
      "image": "ghcr.io/rdborg/mediarium:latest",
      "container_name": "{ServiceName}",
      "restart": "unless-stopped",
      "environment": [
        "PUID=1000",
        "PGID=1000",
        "TZ=auto",
        "DOWNLOADS_DIR=/data/downloads/mediarium",
        "MOVIES_DIR=/data/movies",
        "TV_DIR=/data/tv"
      ],
      "labels": {
        "cosmos-force-network-secured": "true",
        "cosmos-auto-update": "true",
        "cosmos-icon": "https://azukaar.github.io/cosmos-servapps-official/servapps/Mediarium/icon.png"
      },
      "volumes": [
        {
          "source": "{ServiceName}-config",
          "target": "/config",
          "type": "volume"
        },
        {
          "source": "{Context.data_path}",
          "target": "/data",
          "type": "bind"
        }
      ],
      "routes": [
        {
          "name": "{ServiceName}",
          "description": "Web interface",
          "useHost": true,
          "target": "http://{ServiceName}:8264",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "SmartShield": {
            "Enabled": true
          }
        }
      ]
    }
  }
}
